# Copy to backend/.env for local development.
ENVIRONMENT=development
DATABASE_URL=postgresql://br_login:br_login@localhost:5432/boardroom
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-at-least-32-chars
WEB_ORIGIN=http://localhost:5173
MAILER=console
# To send through the local inbox in docker-compose (http://localhost:8025):
# MAILER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURITY=none
# SMTP_FROM=hello@boardroom.local
DISPATCH_INLINE=true
